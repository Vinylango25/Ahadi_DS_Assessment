{
  "version": 2,
  "framework": null,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist/browser",
  "functions": {
    "api/ai/county-insight.js": { "memory": 256, "maxDuration": 30 },
    "api/ai/national-insight.js": { "memory": 256, "maxDuration": 30 },
    "api/ai/query.js": { "memory": 256, "maxDuration": 30 }
  },
  "routes": [
    {
      "src": "/(.*\\.(json|geojson|js|css|png|svg|ico|woff2?))",
      "headers": { "Cache-Control": "public, max-age=3600" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
