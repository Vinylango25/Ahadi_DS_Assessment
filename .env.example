# ============================================================
# Ahadi Kenya Population Analytics — Environment Template
# Copy this file to .env and fill in your values
# ============================================================

# ── LLM (Groq — free at https://console.groq.com) ───────────
# Primary key (required for AI features)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional extra keys — rotated automatically on 429 rate-limit
# Add up to 5 keys from separate free Groq accounts to multiply your daily quota
GROQ_API_KEY_1=gsk_second_key_here
GROQ_API_KEY_2=gsk_third_key_here
GROQ_API_KEY_3=gsk_fourth_key_here
GROQ_API_KEY_4=gsk_fifth_key_here
GROQ_API_KEY_5=gsk_sixth_key_here
GROQ_MODEL=qwen/qwen3.6-27b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=6000

# ── OpenAI (optional fallback) ───────────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Backend ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./backend/ahadi.db
API_HOST=0.0.0.0
API_PORT=8000

# ── Data pipeline ────────────────────────────────────────────
WORLDPOP_BASE_URL=https://data.worldpop.org/GIS/AgeSex_structures/Global_2000_2020_1km_UNadj/unconstrained
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
