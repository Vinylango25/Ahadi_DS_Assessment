# ============================================================
# Ahadi Kenya Population Analytics — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
.python-version

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# ── Environment / secrets ────────────────────────────────────
.env
!.env.example

# ── Data files (large GeoTIFFs) ──────────────────────────────
data/raw/
# Keep processed outputs but not raw rasters
!data/raw/.gitkeep

# ── Database ─────────────────────────────────────────────────
# Pre-seeded DB is committed so Render starts with data immediately
# backend/ahadi.db   ← intentionally tracked
backend/*.db.bak
*.sqlite
*.sqlite3

# ── Node / Angular ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Test / coverage ──────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

.vercel
